RewriteEngine On
RewriteBase /

# If the request is for an existing file/dir in out/, serve it
RewriteCond %{DOCUMENT_ROOT}/out%{REQUEST_URI} -f [OR]
RewriteCond %{DOCUMENT_ROOT}/out%{REQUEST_URI} -d
RewriteRule ^(.*)$ out/$1 [L]

# Default: serve out/index.html
RewriteRule ^$ out/index.html [L]

# Fallback for any other request
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ out/$1 [L]
